# ESP-VISION WT9932P4C5-S1 defaults.

# Target
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# Flash
CONFIG_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Memory (PSRAM 200MHz, per WT99P4C5-S1 factory spec)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MEMTEST=
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=50768
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ULP is not used on WT9932P4C5-S1 bring-up.
CONFIG_SOC_ULP_SUPPORTED=n
CONFIG_ULP_COPROC_ENABLED=n
CONFIG_ULP_COPROC_TYPE_FSM=n

# Cache/SOC
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Logging (verbose for bring-up debug)
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Camera (OV5647 MIPI CSI)
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS=y
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1280X960_BINNING_45FPS=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# WiFi (external ESP32-C5 via SDIO/esp-hosted) is temporarily disabled for the
# P4-only bring-up. On esp32p4 the esp_wifi_remote managed component defaults
# ESP_WIFI_REMOTE_ENABLED=y (no native Wi-Fi), which in turn defaults
# ESP_HOSTED_ENABLED=y, so esp-hosted must be switched off explicitly or it will
# still initialize (and its SDIO DMA mempool fails on this board).
# To re-enable Wi-Fi: remove this line, restore the ESP_HOSTED_* SDIO pin block,
# and add sdkconfig.p4_wifi_{common,c5} back to mpconfigboard.cmake.
CONFIG_ESP_HOSTED_ENABLED=n
