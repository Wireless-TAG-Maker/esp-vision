# ESP-VISION WT9932S31-TINY defaults.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_FREERTOS_HZ=1000
CONFIG_VFS_MAX_COUNT=16

# EV-MUX redirects C stdout/stderr through Newlib's FILE write hooks.
CONFIG_LIBC_NEWLIB=y

# USB-Serial/JTAG is independent of the native USB CDC/MSC port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# GC2145's complete UXGA table is adapted to UYVY at 8 fps by the board.
CONFIG_CAMERA_GC2145=y
CONFIG_CAMERA_GC2145_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_GC2145_DVP_RGB565_BE_1600X1200_13FPS=y
CONFIG_CAMERA_GC2145_DVP_DEFAULT_FMT_RGB565_BE_1600X1200_13FPS=y
CONFIG_CAMERA_GC2145_DVP_IF_FORMAT_INDEX_DEFAULT=1
CONFIG_CAMERA_GC2145_WRITE_REGS_DELAY_US=300
CONFIG_CAM_CTRL_SPI_ENABLE=n
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_SWAP_BYTE=n
